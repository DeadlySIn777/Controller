b_id "CNC:PWR_FLAG") (at 279.40000000000003 480.06 0) (unit 1) (in_bom no) (on_board no) (dnp no) (uuid "5641420d-027d-5300-9ded-7293e65dc2e7") (property "Reference" "#FLG4" (at 284.48 469.9 0) (effects (font (size 0.95 0.95)))) (property "Value" "NORMAL PATH" (at 284.48 472.44 0) (effects (font (size 0.95 0.95)))) (property "Footprint" "" (at 284.48 469.9 0) (effects (font (size 0.95 0.95)) hide)) (property "MPN" "" (at 284.48 469.9 0) (effects (font (size 0.95 0.95)) hide)) (instances (project "core_converter" (path "/36b02862-8835-5c37-aaae-7019115ba32a" (reference "#FLG4") (unit 1))))) (wire (pts (xy 279.4 480.06) (xy 279.4 474.98)) (stroke (width 0) (type default)) (uuid "22ad1172-3736-591b-b17d-7eaf82df0cf6")) (label "IO_3V3" (at 279.4 474.98 0) (effects (font (size 0.95 0.95)) (justify left bottom)) (uuid "549527ad-81e0-5026-9d08-3bd50bf48b7b")) (text "CORE 5 V / 6 A CONVERTER CANDIDATE - ENGINEERING CIRCUIT" (at 20.32 15.24 0) (effects (font (size 2.2 2.2)) (justify left top)) (uuid "838652e9-95b9-58f0-bc38-6e70d63269da")) (text "LM70660: protected nominal24V input; no display/AI/drive power. C_PGOOD is analog enable, not GPIO.\nUpstream R9 must be absent. VIN powers internal startup bias; no running host/ESP is needed to enable this converter." (at 20.32 27.94 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "ffedcf97-230c-5b62-a74c-138b15971e4a")) (text "Layout: Kelvin ISNS+/VOUT across RS1; separate quiet AGND returns join local power ground as TI specifies.\nSW4 bootstrap return is internally common with SW1-3; preserve local bootstrap loop. No external long SW4 strap.\nU1 RRX, RS1 long-side0612 and polarized bulk footprints unassigned; no generic substitutions.\nBulk + three MLCCs require delayed SBC branch and revised compensation. Transient margin is conditional.\nCompensation, negative clamps and reverse feed remain unqualified. No finished PCB or machine permission." (at 20.32 520.7 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "f10b352f-48dc-5536-9fa3-d248468147ac")))
