))(property "MPN" ""(at 383.53999999999996 330.2 0)(effects (font (size 1.0 1.0)) hide))(property "Footprint" ""(at 383.53999999999996 330.2 0)(effects (font (size 1.0 1.0)) hide))(instances(project "is1_watchdogs"(path "/255118aa-1722-5766-a1f0-fdf4f36d6259"(reference "#FLG2")(unit 1)))))(wire(pts(xy 383.54 330.2)(xy 383.54 335.28))(stroke(width 0)(type default))(uuid "754fcba6-d29f-570b-9f6b-08bb11a5afce"))(label "LOGIC_GND"(at 383.54 335.28 0)(effects (font (size 0.95 0.95)) (justify left bottom))(uuid "44674f8a-fa82-5465-a93a-3ec66c582c33"))(text "IS-2 PROPOSAL: DUAL WATCHDOG STARTUP CONDITIONING - SEPARATE REVIEW CANDIDATE"(at 15.24 17.78 0)(effects (font (size 2.1 2.1)) (justify left top))(uuid "7e2bea3e-0867-5c45-ada5-5b9aab703010"))(text "NOT CONNECTED TO THE ASSEMBLY. No complete permission chain, latches, field outputs, PCB or physical qualification."(at 15.24 30.48 0)(effects (font (size 1.25 1.25)) (justify left top))(uuid "2fc1d8bc-1cdb-572e-869c-7b944073d98e"))(text "Separate timers / shared IO_3V3 and LOGIC_GND / G18 threshold is not a 3.3V power-good qualification / all inputs INTERNAL logic."(at 15.24 40.64 0)(effects (font (size 1.15 1.15)) (justify left top))(uuid "7d7b1525-175b-59f0-85dd-9c2f74be611e"))(text "4.7k FPGA-facing pulls; SET1 = request AND FPGA_USER_RESET_N. Active-HIGH polarity / 1us pulse contract unchanged. MR open."(at 15.24 51.0 0)(effects (font (size 1.2 1.2)) (justify left top))(uuid "e1294e48-545d-53d5-8d0f-feb81cba7d7f"))(text "WDI: one 1us high pulse, idle LOW. FALLING edges feed timer.\nOld toggle-per-UPDATE gateware is INCOMPATIBLE.\n3.3nF C0G: calculated timing, never a measured20ms proof."(at 292.1 53.34 0)(effects (font (size 1.15 1.15)) (justify left top))(uuid "43b1fd64-9d57-5d4e-93d2-fb8a024900ec"))(text "Each RESET + WDO wired-AND with\n10k pull-up. WD_M_OK / WD_O_OK\nhave100k pulls; partial power UNQUALIFIED.\nNo sticky permission latch in this block."(at 432.0 121.0 0)(effects (font (size 1.15 1.15)) (justify left top))(uuid "93ccc62a-93a6-5f02-ba54-b5638dcfea98"))(text "4.7k replaces four FPGA-facing100k pulls.\nTwo SET1 AND gates add reset guard / LOW drive.\nSame request polarity; separate proposals only.\nSET1 pin leakage has NO published maximum.\nLoaded LOW, reset slew and partial power UNQUALIFIED."(at 432.0 277.0 0)(effects (font (size 1.1 1.1)) (justify left top))(uuid "61af2c9e-1c50-54c8-ae95-9fe24da28544"))(text "DRB copper-pad candidate only: paste/stencil, thermal vias, CWD guarding/cleanliness/leakage, routing, partial power and brownout remain unqualified."(at 15.24 449.58 0)(effects (font (size 1.05 1.05)) (justify left top))(uuid "c108bd8d-8217-579e-91de-ed39b1a7e469")))
