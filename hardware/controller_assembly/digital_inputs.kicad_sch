t)) (uuid "35c2ff6d-fce7-5637-8abd-da992f391391")) (label "ALM2_FPGA" (at 988.06 754.38 0) (effects (font (size 0.9 0.9)) (justify left bottom)) (uuid "69bc0810-d85e-50db-b709-1334d4f30369")) (wire (pts (xy 1054.1 759.46) (xy 988.06 759.46)) (stroke (width 0) (type default)) (uuid "ee02c527-3d51-5fa6-9a72-dece0b13a55e")) (label "ALM3_FPGA" (at 988.06 759.46 0) (effects (font (size 0.9 0.9)) (justify left bottom)) (uuid "d114235e-a049-592d-bd0d-ecb2b052738f")) (wire (pts (xy 1054.1 764.54) (xy 988.06 764.54)) (stroke (width 0) (type default)) (uuid "df3aa609-e0bc-5fa4-8208-ffccd15d6192")) (label "ALM4_FPGA" (at 988.06 764.54 0) (effects (font (size 0.9 0.9)) (justify left bottom)) (uuid "884032fd-eb6c-5799-965e-6238f6914362")) (wire (pts (xy 1054.1 769.62) (xy 988.06 769.62)) (stroke (width 0) (type default)) (uuid "5964db28-f6c5-5dd5-bed4-528b9fde4380")) (label "ALM5_FPGA" (at 988.06 769.62 0) (effects (font (size 0.9 0.9)) (justify left bottom)) (uuid "a19b67a8-0036-5926-9d01-a7e5fa886771")) (text "BASELINE 22 ISOLATED SINKING DIGITAL INPUTS - 6 HOME + 16 AUXILIARY - REVIEW r0.1" (at 20.32 15.24 0) (effects (font (size 3 3)) (justify left top)) (uuid "0af4cfd1-0c32-52a5-9772-171a04d289f0")) (text "0-30V input study; low<=5V / high>=15V targets. PNP source or dry contact to field positive. Common FIELD_GND; no per-channel isolation.\n11 ISO1212 devices require IO_3V3 only. Do not join FIELD_GND to LOGIC_GND. SUB pins get separate floating copper islands; never ground or join them." (at 20.32 29.21 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "d7167672-218b-56e8-96f2-1be1ec176119")) (text "All JDI names/positions match frozen ledger.\nJDI0/1 have no local common terminal: use JDI2.7/.8.\nNo sensor positive supply is provided by this sheet.\nBoundary symbols are not approved connector MPNs.\nNo PE capacitor fitted: whole-system coupling/EMC is open." (at 790 533.4 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "f37bd8e3-a743-51c7-bb95-ae546c412706")) (text "EN is tied to IO_3V3. Powered open input reads LOW. Unpowered/brownout output is UNDETERMINED; pull-down is bias, not a fail-safe guarantee.\nMask all inputs until qualified rail/FPGA readiness. PROBE/TOOLSETTER filters need latency qualification. No safety input certification, physical EMC result or PCB release." (at 20.32 808 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "ae1a884f-b3cc-5049-ac2d-a9d7d06cc71a")))
