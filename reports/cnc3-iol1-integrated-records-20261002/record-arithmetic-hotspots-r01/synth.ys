read_verilog -sv cnc_iol1_record_master.v cnc_iol1_record_acquisition.v cnc_mbr2_stream_checker.v cnc3_alarm_filter.v cnc3_encoder_runtime.v cnc3_motion_spi.v cnc3_motion_state.v cnc3_rate_admission_serial.v cnc3_spi_transport_stateful.v cnc3_stepgen_runtime.v cnc3_spi_transport.v cnc3_command_validate.v cnc3_motion_acquisition_composition.v
hierarchy -check -top cnc3_motion_acquisition_composition
proc
check -assert
select -assert-none t:$dlatch t:$adlatch t:$dlatchsr
synth_efinix -noflatten -top cnc3_motion_acquisition_composition
delete t:$scopeinfo
check -assert -mapped
select -assert-none t:EFX_LATCH t:$_DLATCH_* t:$dlatch t:$adlatch t:$dlatchsr
tee -o mapped-stat.json stat -json
write_json family-mapped.json
