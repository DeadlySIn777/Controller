# The only transport is an in-process model compiled from actual CNC1 RTL.
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt cnc1_sim
# Feedback precedes LinuxCNC calculations; command publish follows them.
addf cnc1.read servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf cnc1.write servo-thread
net x-command joint.0.motor-pos-cmd => cnc1.0.position-cmd
net y-command joint.1.motor-pos-cmd => cnc1.1.position-cmd
net z-command joint.2.motor-pos-cmd => cnc1.2.position-cmd
net x-return cnc1.0.position-fb => joint.0.motor-pos-fb
net y-return cnc1.1.position-fb => joint.1.motor-pos-fb
net z-return cnc1.2.position-fb => joint.2.motor-pos-fb
net drive-enable joint.0.amp-enable-out => cnc1.enable
net cnc1-fault cnc1.fault => joint.0.amp-fault-in joint.1.amp-fault-in joint.2.amp-fault-in
net simulated-estop iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in
net simulated-tool-prepare iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net simulated-tool-change iocontrol.0.tool-change => iocontrol.0.tool-changed
