(rule "U11012 exact PG fine-pitch neck only"
 (condition "A.Type == 'Track' && A.Layer == 'F.Cu' && A.NetName == '/motherboard_power_entry/SBC_SWITCH_PG' && A.Width == 0.125mm && A.enclosedByArea('U11012_LITERAL_PG_NECK')")
 (constraint track_width (min 0.125mm) (max 0.125mm))
 (constraint track_segment_length (max 0.9mm)))
