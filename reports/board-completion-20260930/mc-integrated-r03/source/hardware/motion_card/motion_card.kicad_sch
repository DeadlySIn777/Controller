(kicad_sch (version 20250114) (generator "motion_card_candidate") (uuid "3a792142-74d5-555a-9532-a6d959dd40ca") (paper "A0") (lib_symbols) (title_block (title "Motion card circuit candidate") (date "2026-09-30") (rev "r0.3-proposed-IS2")) (text "PROPOSED IS-2 MC CIRCUIT CANDIDATE: FPGA, autonomous local rails, conditioned dual watchdogs, permission/OPI/trip latches and 12-motor Ioff buffers.\n38 motor/TX paths use actual Ioff buffers; other Ioff paths, presence filters, identity, slot-status register, flash restore and connectors remain missing.\nMC_RAILS_OK uses qualified destination-rail FPGA_CRESET_N, not MC_RAILS_OK_5V. CDONE qualification uses delayed FPGA_USER_RESET_N; timing is unqualified.\nLegacy progress ball is proposed as FPGA_PROGRESS_M; A2 is the independent RAW_INHIBIT_N input. Reserved enable balls now connect to EN_N buffers; vendor fit, CNC1 pulse generation and remaining GPIO allocation are open.\nBank-B qualified OE is the same physical net as OPI_BOE clear. Receiving cards must pull EN_N high from their own powered rail; those receivers remain separate unfinished circuits.\nNative schematic ERC is distinct from PCB DRC, vendor FPGA fit and measurements. NOT FOR MANUFACTURE." (at 20 20 0) (effects (font (size 1.35 1.35)) (justify left top)) (uuid "2e64d906-3319-5d06-bd4d-58d4f6cd9336")) (sheet (at 292.1 76.2) (size 139.7 365.76) (stroke (width 0.254) (type default)) (fill (color 0 0 0 0)) (uuid "43eb62ac-4dbf-5ba8-8225-ed698d4f3714") (property "Sheetname" "fpga_core" (at 292.1 73.2 0) (effects (font (size 1.5 1.5)) (justify left))) (property "Sheetfile" "fpga_core.kicad_sch" (at 292.1 444.96 0) (effects (font (size 1 1)) (justify left))) (pin "CORE_1V2" bidirectional (at 292.1 83.82 180) (effects (font (size 1.1 1.1))) (uuid "a4779613-28cc-5023-9191-5aceb5270eec")) (pin "DIR0_FPGA" bidirectional (at 292.1 91.44 180) (effects (font (size 1.1 1.1))) (uuid "1b90928c-c2ad-5588-a67d-2d419ce08d4e")) (pin "DIR10_FPGA" bidirectional (at 292.1 99.06 180) 